{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(bash scripts/check-:*)",
      "Bash(zsh scripts/check-:*)",
      "Bash(node scripts/check-:*)",
      "Bash(python3 scripts/check-:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(node --test scripts/tests/:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/root-worktree-main-only.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/design-guide-first.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
