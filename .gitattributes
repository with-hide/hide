hide-memory/vendor/mem0/** -whitespace
*.cmd text eol=crlf
# The OpenCode plugin's marker hashes its exact bytes; a CRLF checkout would change them.
hide-agent-hooks/src/opencode/plugin.js text eol=lf
hide-agent-hooks/tests/fixtures/hook-bytes/opencode-plugin.js text eol=lf
# Pi's and omp's extension the same way: one source, and two pinned files.
hide-agent-hooks/src/pi_extension/extension.js text eol=lf
hide-agent-hooks/tests/fixtures/hook-bytes/pi-extension.ts text eol=lf
hide-agent-hooks/tests/fixtures/hook-bytes/omp-extension.ts text eol=lf
# agy's recorded log records, byte for byte: its error message ends a line with a space.
hide-agent-hooks/tests/fixtures/agy-errors/*.log -whitespace text eol=lf
