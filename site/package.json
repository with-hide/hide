{
  "name": "hide-site",
  "private": true,
  "type": "module",
  "description": "withhide.dev: the landing page (public/) and the user docs (src/content/docs/docs/), one Astro project",
  "scripts": {
    "predev": "node ../scripts/docs/check-features.mjs src/content/docs/docs --write src/generated/used-in.json",
    "dev": "astro dev",
    "prebuild": "node ../scripts/docs/check-features.mjs src/content/docs/docs --write src/generated/used-in.json",
    "build": "astro build && node scripts/add-embed.mjs",
    "preview": "astro preview",
    "test": "node --test tests/"
  },
  "dependencies": {
    "@astrojs/starlight": "0.34.8",
    "astro": "5.18.2"
  }
}
