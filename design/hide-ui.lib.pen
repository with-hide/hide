                                  "id": "fnd-pal-light-terminal-terminal-blue",
                                  "name": "terminal-blue",
                                  "layout": "vertical",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "children": [
                                    {
                                      "type": "rectangle",
                                      "id": "fnd-pal-light-terminal-terminal-blue-cell",
                                      "name": "Colour",
                                      "width": "fill_container",
                                      "height": 24,
                                      "fill": "$--terminal-blue",
                                      "cornerRadius": "$--radius-xs"
                                    },
