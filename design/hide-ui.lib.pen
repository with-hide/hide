                                      "id": "fnd-pal-light-terminal-terminal-yellow-cell",
                                      "name": "Colour",
                                      "width": "fill_container",
                                      "height": 24,
                                      "fill": "$--terminal-yellow",
                                      "cornerRadius": "$--radius-xs"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-terminal-terminal-yellow-value",
                                      "name": "8A5F00",
