                                      "id": "fnd-pal-light-terminal-terminal-white-cell",
                                      "name": "Colour",
                                      "width": "fill_container",
                                      "height": 24,
                                      "fill": "$--terminal-white",
                                      "cornerRadius": "$--radius-xs"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-terminal-terminal-white-value",
                                      "name": "8C959F",
                                      "fill": "$--muted-foreground",
                                      "content": "8C959F",
                                      "fontFamily": "$--font-mono",
                                      "fontSize": "$--text-micro",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-terminal-bright",
                              "name": "Bright",
                              "layout": "horizontal",
                              "gap": "$--spacing-xs",
                              "alignItems": "start",
                              "width": "fill_container",
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-terminal-terminal-bright-black",
                                  "name": "terminal-bright-black",
                                  "layout": "vertical",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "children": [
                                    {
                                      "type": "rectangle",
                                      "id": "fnd-pal-light-terminal-terminal-bright-black-cell",
                                      "name": "Colour",
                                      "width": "fill_container",
                                      "height": 24,
                                      "fill": "$--terminal-bright-black",
                                      "cornerRadius": "$--radius-xs"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-terminal-terminal-bright-black-value",
                                      "name": "62686F",
                                      "fill": "$--muted-foreground",
                                      "content": "62686F",
                                      "fontFamily": "$--font-mono",
                                      "fontSize": "$--text-micro",
                                      "fontWeight": "normal"
