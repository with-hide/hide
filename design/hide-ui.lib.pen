                                  "id": "fnd-pal-light-terminal-terminal-bright-red",
                                  "name": "terminal-bright-red",
                                  "layout": "vertical",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "children": [
                                    {
                                      "type": "rectangle",
                                      "id": "fnd-pal-light-terminal-terminal-bright-red-cell",
                                      "name": "Colour",
                                      "width": "fill_container",
                                      "height": 24,
                                      "fill": "$--terminal-bright-red",
                                      "cornerRadius": "$--radius-xs"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-terminal-terminal-bright-red-value",
                                      "name": "A3212A",
                                      "fill": "$--muted-foreground",
                                      "content": "A3212A",
                                      "fontFamily": "$--font-mono",
                                      "fontSize": "$--text-micro",
                                      "fontWeight": "normal"
                                    }
