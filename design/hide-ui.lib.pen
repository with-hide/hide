            },
            {
              "type": "text",
              "id": "CwbIz",
              "name": "Spec",
              "fill": "$--subtle-foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "sidebar.tsx CheckoutRowView: the kind glyph and the name read on the left, 12/400 (500 while its Workspace is in front) with the path prefix up to the first slash muted. While its agent rows are folded, line one ends in the status badge, which counts them under the mark each row draws, then the fold slot, whose chevron is there only while agents run; opening them takes the badge away, since their own marks now speak, and changes nothing else on the row. Line two is the purpose, 11 on a 16 line, and the last-commit age ends it on the column every row’s time ends on; a row without a purpose is one line, 32 high, with its age there, and a row with one is 48. Nothing moves on hover or while the right-click menu is open. An opened checkout and its agent rows share one small group fill with 4 inside above and below.",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-caption",
              "fontWeight": "normal"
            }
          ]
