{
  "version": "2.20",
  "children": [
    {
      "type": "frame",
      "id": "fnd-sheet",
      "name": "System / Foundations",
      "clip": true,
      "width": 1180,
      "fill": "$--background",
      "layout": "vertical",
      "gap": "$--spacing-xxxl",
      "padding": "$--spacing-xxl",
      "children": [
        {
          "type": "frame",
          "id": "fnd-title",
          "name": "Title block",
          "layout": "vertical",
          "gap": "$--spacing-sm",
          "width": "fill_container",
          "children": [
            {
              "type": "text",
              "id": "fnd-title-name",
              "name": "Hide",
              "fill": "$--foreground",
              "content": "Hide",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-display",
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "fnd-title-sub",
              "name": "Medium density, light an",
              "fill": "$--subtle-foreground",
              "content": "Medium density, light and dark. Four-step surface ladder, 1px hairlines, no drop shadows. Every value on this sheet is read from the canvas variables that gen-pen.mjs writes from design/tokens.json, and the sheet itself is redrawn by the same run.",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-subhead",
              "fontWeight": "normal",
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "fnd-palette",
          "name": "Palette",
          "layout": "vertical",
          "gap": "$--spacing-lg",
          "width": "fill_container",
          "children": [
            {
              "type": "frame",
              "id": "fnd-palette-head",
              "name": "Heading",
              "layout": "vertical",
              "gap": "$--spacing-xs",
              "width": "fill_container",
              "children": [
                {
                  "type": "text",
                  "id": "fnd-palette-title",
                  "name": "PALETTE",
                  "fill": "$--muted-foreground",
                  "content": "PALETTE",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-caption",
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "fnd-palette-note",
                  "name": "Two theme axes on the sa",
                  "fill": "$--subtle-foreground",
                  "content": "Two theme axes on the same variables: Mode gives each color a Light and a Dark value, and Palette chooses the Neutral color theme (the default, which every System and Component frame draws) or the Hide color theme the app opens in. A color Hide does not change is the same in both.",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-subhead",
                  "fontWeight": "normal",
                  "textGrowth": "fixed-width",
                  "width": "fill_container"
                }
              ]
            },
            {
              "type": "frame",
              "id": "fnd-palette-themes",
              "name": "Palettes",
              "layout": "vertical",
              "gap": "$--spacing-xl",
              "width": "fill_container",
              "children": [
                {
                  "type": "frame",
                  "id": "fnd-palette-frames",
                  "name": "Neutral",
                  "layout": "horizontal",
                  "gap": "$--spacing-xl",
                  "alignItems": "start",
                  "width": "fill_container",
                  "children": [
                    {
                      "type": "frame",
                      "id": "fnd-palette-light",
                      "name": "Neutral Light",
                      "layout": "vertical",
                      "gap": "$--spacing-lg",
                      "width": 540,
                      "clip": true,
                      "padding": "$--spacing-xl",
                      "fill": "$--background",
                      "cornerRadius": "$--radius-lg",
                      "theme": {
                        "Mode": "Light"
                      },
                      "children": [
                        {
                          "type": "frame",
                          "id": "fnd-palette-light-base",
                          "name": "Base",
                          "layout": "vertical",
                          "gap": "$--spacing-md",
                          "width": "fill_container",
                          "children": [
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-surface",
                              "name": "Ladder",
                              "layout": "horizontal",
                              "gap": 0,
                              "alignItems": "start",
                              "width": "fill_container",
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-surface-background",
                                  "name": "background",
                                  "layout": "vertical",
                                  "justifyContent": "end",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "height": 120,
                                  "padding": "$--spacing-lg",
                                  "fill": "$--background",
                                  "stroke": "$--border",
                                  "strokeWidth": "$--size-hairline",
                                  "strokeAlignment": "inner",
                                  "cornerRadius": [
                                    "$--radius-lg",
                                    0,
                                    0,
                                    "$--radius-lg"
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-surface-background-label",
                                      "name": "background",
                                      "fill": "$--foreground",
                                      "content": "background",
                                      "fontFamily": "$--font-ui",
                                      "fontSize": "$--text-caption",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-surface-sidebar",
                                  "name": "sidebar",
                                  "layout": "vertical",
                                  "justifyContent": "end",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "height": 120,
                                  "padding": "$--spacing-lg",
                                  "fill": "$--sidebar",
                                  "stroke": "$--border",
                                  "strokeWidth": "$--size-hairline",
                                  "strokeAlignment": "inner",
                                  "cornerRadius": 0,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-surface-sidebar-label",
                                      "name": "sidebar",
                                      "fill": "$--foreground",
                                      "content": "sidebar",
                                      "fontFamily": "$--font-ui",
                                      "fontSize": "$--text-caption",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-surface-card",
                                  "name": "card",
                                  "layout": "vertical",
                                  "justifyContent": "end",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "height": 120,
                                  "padding": "$--spacing-lg",
                                  "fill": "$--card",
                                  "stroke": "$--border",
                                  "strokeWidth": "$--size-hairline",
                                  "strokeAlignment": "inner",
                                  "cornerRadius": 0,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-surface-card-label",
                                      "name": "card",
                                      "fill": "$--foreground",
                                      "content": "card",
                                      "fontFamily": "$--font-ui",
                                      "fontSize": "$--text-caption",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-surface-popover",
                                  "name": "popover",
                                  "layout": "vertical",
                                  "justifyContent": "end",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "height": 120,
                                  "padding": "$--spacing-lg",
                                  "fill": "$--popover",
                                  "stroke": "$--border",
                                  "strokeWidth": "$--size-hairline",
                                  "strokeAlignment": "inner",
                                  "cornerRadius": 0,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-surface-popover-label",
                                      "name": "popover",
                                      "fill": "$--foreground",
                                      "content": "popover",
                                      "fontFamily": "$--font-ui",
                                      "fontSize": "$--text-caption",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-surface-secondary",
                                  "name": "secondary",
                                  "layout": "vertical",
                                  "justifyContent": "end",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "height": 120,
                                  "padding": "$--spacing-lg",
                                  "fill": "$--secondary",
                                  "stroke": "$--border",
                                  "strokeWidth": "$--size-hairline",
                                  "strokeAlignment": "inner",
                                  "cornerRadius": [
                                    0,
                                    "$--radius-lg",
                                    "$--radius-lg",
                                    0
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-surface-secondary-label",
                                      "name": "secondary",
                                      "fill": "$--foreground",
                                      "content": "secondary",
                                      "fontFamily": "$--font-ui",
                                      "fontSize": "$--text-caption",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-ink",
                              "name": "Inks",
                              "layout": "horizontal",
                              "gap": "$--spacing-lg",
                              "alignItems": "start",
                              "width": "fill_container",
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-ink-foreground",
                                  "name": "foreground",
                                  "layout": "vertical",
                                  "gap": "$--spacing-xs",
                                  "width": "fit_content",
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-ink-foreground-word",
                                      "name": "foreground",
                                      "fill": "$--foreground",
                                      "content": "foreground",
                                      "fontFamily": "$--font-ui",
                                      "fontSize": "$--text-title",
                                      "fontWeight": "600"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-ink-foreground-value",
                                      "name": "#18181B",
                                      "fill": "$--muted-foreground",
                                      "content": "#18181B",
                                      "fontFamily": "$--font-mono",
                                      "fontSize": "$--text-micro",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-ink-subtle-foreground",
                                  "name": "subtle-foreground",
                                  "layout": "vertical",
                                  "gap": "$--spacing-xs",
                                  "width": "fit_content",
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-ink-subtle-foreground-word",
                                      "name": "subtle-foreground",
                                      "fill": "$--subtle-foreground",
                                      "content": "subtle-foreground",
                                      "fontFamily": "$--font-ui",
                                      "fontSize": "$--text-title",
                                      "fontWeight": "600"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-ink-subtle-foreground-value",
                                      "name": "#52525B",
                                      "fill": "$--muted-foreground",
                                      "content": "#52525B",
                                      "fontFamily": "$--font-mono",
                                      "fontSize": "$--text-micro",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-ink-muted-foreground",
                                  "name": "muted-foreground",
                                  "layout": "vertical",
                                  "gap": "$--spacing-xs",
                                  "width": "fit_content",
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-ink-muted-foreground-word",
                                      "name": "muted-foreground",
                                      "fill": "$--muted-foreground",
                                      "content": "muted-foreground",
                                      "fontFamily": "$--font-ui",
                                      "fontSize": "$--text-title",
                                      "fontWeight": "600"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-ink-muted-foreground-value",
                                      "name": "#6D6D76",
                                      "fill": "$--muted-foreground",
                                      "content": "#6D6D76",
                                      "fontFamily": "$--font-mono",
                                      "fontSize": "$--text-micro",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-ink-primary",
                                  "name": "primary",
                                  "layout": "vertical",
                                  "gap": "$--spacing-xs",
                                  "width": "fit_content",
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-ink-primary-word",
                                      "name": "primary",
                                      "fill": "$--primary",
                                      "content": "primary",
                                      "fontFamily": "$--font-ui",
                                      "fontSize": "$--text-title",
                                      "fontWeight": "600"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-ink-primary-value",
                                      "name": "#84CC16",
                                      "fill": "$--muted-foreground",
                                      "content": "#84CC16",
                                      "fontFamily": "$--font-mono",
                                      "fontSize": "$--text-micro",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "fnd-pal-light-terminal",
                          "name": "Terminal",
                          "layout": "vertical",
                          "gap": "$--spacing-sm",
                          "width": "fill_container",
                          "children": [
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-terminal-normal",
                              "name": "Normal",
                              "layout": "horizontal",
                              "gap": "$--spacing-xs",
                              "alignItems": "start",
                              "width": "fill_container",
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-terminal-terminal-black",
                                  "name": "terminal-black",
                                  "layout": "vertical",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "children": [
                                    {
                                      "type": "rectangle",
                                      "id": "fnd-pal-light-terminal-terminal-black-cell",
                                      "name": "Colour",
                                      "width": "fill_container",
                                      "height": 24,
                                      "fill": "$--terminal-black",
                                      "cornerRadius": "$--radius-xs"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-terminal-terminal-black-value",
                                      "name": "24292F",
                                      "fill": "$--muted-foreground",
                                      "content": "24292F",
                                      "fontFamily": "$--font-mono",
                                      "fontSize": "$--text-micro",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-terminal-terminal-red",
                                  "name": "terminal-red",
                                  "layout": "vertical",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "children": [
                                    {
                                      "type": "rectangle",
                                      "id": "fnd-pal-light-terminal-terminal-red-cell",
                                      "name": "Colour",
                                      "width": "fill_container",
                                      "height": 24,
                                      "fill": "$--terminal-red",
                                      "cornerRadius": "$--radius-xs"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-terminal-terminal-red-value",
                                      "name": "C8323A",
                                      "fill": "$--muted-foreground",
                                      "content": "C8323A",
                                      "fontFamily": "$--font-mono",
                                      "fontSize": "$--text-micro",
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "fnd-pal-light-terminal-terminal-green",
                                  "name": "terminal-green",
                                  "layout": "vertical",
                                  "gap": "$--spacing-xxs",
                                  "width": "fill_container",
                                  "children": [
                                    {
                                      "type": "rectangle",
                                      "id": "fnd-pal-light-terminal-terminal-green-cell",
                                      "name": "Colour",
                                      "width": "fill_container",
                                      "height": 24,
                                      "fill": "$--terminal-green",
                                      "cornerRadius": "$--radius-xs"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fnd-pal-light-terminal-terminal-green-value",
                                      "name": "2B7A3B",
