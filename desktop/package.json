{
  "name": "hide-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "The hide desktop host: the web shell hided serves, in its own macOS window.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint src e2e scripts static && node ../web/scripts/check-e2e-test-size.mjs e2e",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && playwright test",
    "package": "node scripts/build.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@electron/fuses": "1.8.0",
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.2",
    "electron": "^44.4.5",
    "electron-builder": "26.17.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.24.0",
    "eslint-plugin-playwright": "^2.12.0",
    "i18next": "26.4.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.1"
  },
  "productName": "hide",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "lottie-web": "5.12.2",
    "ws": "^8.22.0"
  }
}
