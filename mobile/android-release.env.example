# The Android release command's secrets live on the build machine, in ~/.config/hide-android/release.env (mode 600),
# never in the repository and never in the environment. mobile/android-release-env.json owns what each key is and its shape.
HIDE_ANDROID_UPLOAD_KEYSTORE=/absolute/path/to/.config/hide-android/upload.p12
HIDE_ANDROID_UPLOAD_KEY_ALIAS=upload
HIDE_ANDROID_UPLOAD_PASSWORD=the-keystore-password
HIDE_ANDROID_PLAY_SERVICE_ACCOUNT=/absolute/path/to/.config/hide-android/play-service-account.json
