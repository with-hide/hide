# The release command's secrets live on the build machine, in ~/.config/hide-ios/release.env (mode 600),
# never in the repository. mobile/release-env.json owns what each key is and what shape it has.
HIDE_IOS_ASC_KEY_ID=ABCDE12345
HIDE_IOS_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
HIDE_IOS_ASC_KEY_PATH=/Users/<account>/.config/hide-ios/AuthKey_ABCDE12345.p8
