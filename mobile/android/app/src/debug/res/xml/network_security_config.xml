<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build only: a relay fixture on the emulator's loopback (`adb reverse`, build-android.sh run with
     HIDE_ANDROID_RELAY_PORT), the same exception the simulator build's content policy makes. Release keeps src/main's. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
