<?xml version="1.0" encoding="utf-8"?>
<!-- Shown instead of the app on a web view too old to keep the bridge to the main frame (ShellActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/update_webview_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_webview_title"
        android:textAppearance="?android:attr/textAppearanceLarge" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/update_webview_body"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <Button
        android:id="@+id/update_webview_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/update_webview_open" />
</LinearLayout>
