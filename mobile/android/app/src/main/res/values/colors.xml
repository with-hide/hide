<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The phone page's background in its default color theme (Hide's: the background token of `.palette-hide`, light and dark,
         web/src/tokens.css): what shows before its first paint, and behind the system bars where the window is padded for
         them (a web view older than 140, where the page cannot draw under them). -->
    <color name="launch_background_light">#F8FAFD</color>
    <color name="launch_background_dark">#12171B</color>
    <color name="launch_background">@color/launch_background_light</color>
    <!-- The icon art's own background, around the art inside the adaptive icon's mask. -->
    <color name="ic_launcher_background">#B7C9CC</color>
</resources>
