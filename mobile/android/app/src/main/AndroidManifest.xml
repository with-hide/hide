<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked only when the person turns notifications on (HidePushPlugin), on Android 13 and later. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No library may add the advertising id permission: the app shows no ads and tracks no one. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Nothing the app keeps leaves the phone: no cloud backup, no device-to-device transfer, and no clear-text
         connection (the debug build alone may reach a relay fixture on 127.0.0.1, src/debug). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme.NoActionBar">

        <activity
            android:name=".ShellActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A pairing link, https://app.withhide.dev/#pair=<code>: the hosted phone site's root only. The site's
                 assetlinks.json verifies it; until then Android opens the link in the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.withhide.dev" android:path="/" />
            </intent-filter>
        </activity>

        <!-- Where a tap on a notification lands: not exported, so only the app's own notifications name an agent. -->
        <activity
            android:name=".NoticeOpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- The relay's data messages through Firebase Cloud Messaging; Firebase's own receiver checks the sender. -->
        <service
            android:name=".HidePushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- No token is made before the person turns notifications on for a computer (HidePushPlugin.enable). -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
    </application>
</manifest>
