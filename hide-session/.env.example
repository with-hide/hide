# Optional native CLI directory; a non-default root refuses Cursor lifecycle effects.
# CURSOR_CONFIG_DIR=/absolute/account/.cursor
# Optional native CLI config parent; Cursor appends /cursor when its own override is absent.
# XDG_CONFIG_HOME=/absolute/account/.config
# Optional data parent; OpenCode keeps its database in XDG_DATA_HOME/opencode, else ~/.local/share/opencode.
# XDG_DATA_HOME=/absolute/account/.local/share
